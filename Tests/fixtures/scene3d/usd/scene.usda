#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 10
    endTimeCode = 58
    timeCodesPerSecond = 48
    framesPerSecond = 24
)
def Xform "World"
{
    def Xform "Animated" (
        prepend references = @asset.usda@</Asset>
    )
    {
        double3 xformOp:translate.timeSamples = { 10: (-1,0,0), 58: (-1,0,1) }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Instance" (
        prepend references = @asset.usda@</Asset>
        instanceable = true
        variants = { string look = "gold" }
    )
    {
        double3 xformOp:translate = (1,0,0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "Camera"
    {
        double3 xformOp:translate.timeSamples = { 10: (0,0,5), 58: (0.5,0,5) }
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength.timeSamples = { 10: 0.35, 58: 0.4 }
        float horizontalAperture = 0.36
        float verticalAperture = 0.225
        float2 clippingRange = (0.01,1000)
    }
    def DistantLight "Key" (
        prepend apiSchemas = ["LightAPI", "ShadowAPI"]
    )
    {
        float inputs:angle = 0
        float inputs:intensity = 3
        color3f inputs:color = (1,0.95,0.85)
    }
    def SphereLight "Fill" (
        prepend apiSchemas = ["LightAPI", "ShadowAPI"]
    )
    {
        double3 xformOp:translate = (1,1,3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:intensity = 80
        bool inputs:normalize = true
        color3f inputs:color = (0.5,0.7,1)
    }
}
