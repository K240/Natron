#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D sourceImage;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D destinationImage;
layout(push_constant) uniform Transform { vec4 gain; vec4 offset; } transform;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destinationImage)))) {
        return;
    }
    imageStore(destinationImage, pixel,
               imageLoad(sourceImage, pixel) * transform.gain + transform.offset);
}
